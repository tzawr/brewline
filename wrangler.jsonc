{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brewline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brewline",
      "database_id": "25ab4498-6098-4d32-b2e6-c64bf875a5bb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "true" enables one-tap barista/manager demo logins and the demo card. Set to "false" for a real store.
    "DEMO_MODE": "true",
    "APP_URL": ""
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
